#!/bin/sh

# Fail on error
set -e

# rclone refreshes the Google Drive token on every run and must write it back, but the
# mounted config is a read-only Secret. Copy it somewhere writable before using it.
export RCLONE_CONFIG=/tmp/rclone.conf
cp /root/.config/rclone/rclone.conf "$RCLONE_CONFIG"

PVC_NAME=${pvc_name}
RESTIC_REPO="rclone:gdrive:${drive_path}/$PVC_NAME"
BACKUP_PATH=${pvc_volume_mount}
BACKUP_HOST="backup-pvc-$PVC_NAME"
KEEP_LAST=${keep_last}
# rclone buffers --drive-chunk-size in RAM *per transfer*, so 256M meant up to 1GiB of
# buffers at rclone's default --transfers 4. That OOM-killed a 1.18GiB backup on a 4GB
# node. 32M x 2 keeps buffers near 64MB and is still 4x rclone's 8M default.
RCLONE_ARGS="serve restic --stdio --tpslimit=10 --drive-chunk-size=32M --transfers=2 --drive-use-trash=false --fast-list"

%{if password_defined }
RESTIC_PASSWORD_FLAG=""
%{ else }
RESTIC_PASSWORD_FLAG="--insecure-no-password"
%{ endif ~}

EXCLUDE_DIRS=""
%{for dir in exclude_dirs}
EXCLUDE_DIRS="--exclude=$BACKUP_PATH${dir}"
%{ endfor ~}

# Initialize repository if it doesn't exist
init_repository() {
    echo "---Checking repository---"
    if restic -r $RESTIC_REPO cat config $RESTIC_PASSWORD_FLAG -o rclone.args="$RCLONE_ARGS" >/dev/null 2>&1; then
        echo "---Repository exists---"
        return 0
    fi
    echo "---Repository doesn't exist. Initializing---"
    restic -r $RESTIC_REPO init $RESTIC_PASSWORD_FLAG -o rclone.args="$RCLONE_ARGS"
}

# Create backup
create_backup() {
    echo "---Starting backup for $PVC_NAME---"
    restic -r $RESTIC_REPO -v backup $BACKUP_PATH --host $BACKUP_HOST $EXCLUDE_DIRS $RESTIC_PASSWORD_FLAG -o rclone.args="$RCLONE_ARGS"
}

# Cleanup old backups
cleanup_old_backups() {
    echo "---Keeping last $KEEP_LAST backups---"
    restic -r $RESTIC_REPO forget --keep-last $KEEP_LAST --prune $RESTIC_PASSWORD_FLAG
}

# Main execution
main() {
    init_repository
    create_backup
    cleanup_old_backups
}

# Run main function
main
